# העתק לקובץ .env (לא נשמר ב-Git) ומלא ערכים.

# --- OpenAI (ChatGPT API) ---
# מנוי ChatGPT ≠ גישה ל-API. צריך מפתח מ-https://platform.openai.com/api-keys עם קרדיט פעיל.
OPENAI_API_KEY=
# מודל ברירת מחדל לכתיבת תסריט/סטורי בורד. ניתן לדרוס לכל פרויקט בהגדרות הפרויקט.
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ---
PORT=3001
HOST=127.0.0.1
# תיקיית נתונים (SQLite + קבצים שהועלו)
DATA_DIR=./data
# שם שיירשם באישורים ובהיסטוריה
OWNER_NAME=אוהד

# --- Workflow ---
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
STUCK_JOB_MINUTES=10
STALLED_PROJECT_DAYS=3
# טיימר עבודה שרץ יותר מזה — תישלח התראה שאולי נשכח
TIMER_MAX_HOURS=10
