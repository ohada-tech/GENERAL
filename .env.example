# העתק לקובץ .env (לא נשמר ב-Git) ומלא ערכים.

# --- OpenAI (ChatGPT API) ---
# מנוי ChatGPT ≠ גישה ל-API. צריך מפתח מ-https://platform.openai.com/api-keys עם קרדיט פעיל.
OPENAI_API_KEY=
# מודל ברירת מחדל לכתיבת תסריט/סטורי בורד. ניתן לדרוס לכל פרויקט בהגדרות הפרויקט.
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude API) — מבקר ומשפר כל טיוטה ---
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- KIE (kie.ai) — תמונות, וידאו, קריינות ומוזיקה ---
# https://kie.ai/api-key · הקרדיטים נגבים רק בשלבים שאישרת
KIE_API_KEY=

# --- Server ---
PORT=3001
HOST=127.0.0.1
# סיסמת כניסה. חובה כשהשרת פתוח לרשת (HOST שאינו 127.0.0.1) — למשל בענן
APP_PASSWORD=
# תיקיית נתונים (SQLite + קבצים שהועלו)
DATA_DIR=./data
# שם שיירשם באישורים ובהיסטוריה
OWNER_NAME=אוהד

# --- Workflow ---
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
STUCK_JOB_MINUTES=10
STALLED_PROJECT_DAYS=3
# טיימר עבודה שרץ יותר מזה — תישלח התראה שאולי נשכח
TIMER_MAX_HOURS=10
# כמה יצירות רצות במקביל (תמונות/וידאו לכמה שוטים בבת אחת)
JOB_CONCURRENCY=4
